# Database — MySQL 8.0
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/ai_meeting_autopsy"

# Authentication — generated secret (bypassed in MVP, keep for compatibility)
AUTH_SECRET="your-32-byte-hex-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Hugging Face LLM API
HUGGINGFACE_API_KEY="hf_..."
HUGGINGFACE_MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"

# Hugging Face Whisper Inference (Whisper model)
WHISPER_API_KEY="hf_..."
WHISPER_MODEL="openai/whisper-large-v3"
